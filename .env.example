# Lokale Entwicklung
DEBUG=1
SECRET_KEY=django-insecure-local-development-only-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRUST_X_FORWARDED_PROTO=0

# Leer bedeutet lokal: SQLite und prozesslokaler Speicher-Cache.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
DATABASE_SSL_REQUIRED=0
REDIS_URL=
CACHE_KEY_PREFIX=puntero-local

# Lokal werden E-Mails im Terminal ausgegeben.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Puntero <noreply@localhost>
SERVER_EMAIL=Puntero <noreply@localhost>

# Optionale Tipperinnerungen. Standardmäßig ausgeschaltet.
PUBLIC_BASE_URL=http://127.0.0.1:8000
TIP_REMINDERS_ENABLED=0
TIP_REMINDER_LEAD_HOURS=24
TIP_REMINDER_POLL_SECONDS=300

ACCOUNT_EMAIL_VERIFICATION=none
ACCOUNT_EMAIL_CONFIRMATION_EXPIRE_DAYS=3
ACCOUNT_EMAIL_NOTIFICATIONS=0
ALLAUTH_TRUSTED_PROXY_COUNT=0
ALLAUTH_TRUSTED_CLIENT_IP_HEADER=

# Sicherheits- und Aufbewahrungsfristen.
SESSION_COOKIE_AGE=1209600
PASSWORD_RESET_TIMEOUT=3600
DATA_RETENTION_UNVERIFIED_ACCOUNT_DAYS=14
DATA_RETENTION_INACTIVE_ACCOUNT_DAYS=730
DATA_RETENTION_INACTIVE_MEMBERSHIP_DAYS=365
DATA_RETENTION_REMINDER_DELIVERY_DAYS=90

DATA_UPLOAD_MAX_NUMBER_FILES=5
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
LOG_LEVEL=INFO

# Webprozess
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30

# Standing-Worker
MIGRATION_WAIT_SECONDS=5
MIGRATION_WAIT_ATTEMPTS=60
STANDING_JOB_BATCH_SIZE=10
STANDING_JOB_POLL_SECONDS=2
STANDING_JOB_STALE_MINUTES=60

# Produktionsoptionen werden in Railway gesetzt, nicht in dieser Datei:
# DEBUG=0
# DATABASE_SSL_REQUIRED=1
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# SECURE_HSTS_PRELOAD=0
